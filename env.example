# ============================================
# Chemins de données (optionnel - valeurs par défaut dans Docker)
# ============================================
DATA_DIR=/opt/spark/data
DELTA_BRONZE_PATH=/opt/spark/delta/bronze
DELTA_SILVER_PATH=/opt/spark/delta/silver
DELTA_GOLD_PATH=/opt/spark/delta/gold
CHECKPOINT_BRONZE_PATH=/opt/spark/checkpoints/bronze
CHECKPOINT_SILVER_PATH=/opt/spark/checkpoints/silver
CHECKPOINT_GOLD_PATH=/opt/spark/checkpoints/gold

# ============================================
# Configuration Spark (optionnel)
# ============================================
SPARK_APP_NAME=SmartTech-Streaming
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# ============================================
# Configuration Kafka (pour Phase 2.2)
# ============================================
# IMPORTANT : Le port dépend de l'environnement d'exécution
# - kafka:29092 : Pour connexions depuis conteneurs Docker (notebook dans Docker)
# - localhost:9092 : Pour connexions depuis la machine hôte (notebook local)
# Le notebook détecte automatiquement l'environnement, mais vous pouvez forcer la valeur ici
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_IOT=sensor-data-iot
KAFKA_CONSUMER_GROUP=spark-streaming-consumer
# Port Kafka exposé : 9092 (hôte) -> 9092 (conteneur)
# Port Kafka interne : 29092 (pour communication entre conteneurs Docker)

# ============================================
# Configuration Docker (optionnel)
# ============================================
SPARK_UI_PORT=8080
JUPYTER_PORT=8888
SPARK_MASTER_PORT=7077

# ============================================
# Configuration Jupyter (optionnel)
# ============================================
JUPYTER_TOKEN=
JUPYTER_PASSWORD=

# ============================================
# Configuration Producteur Kafka (optionnel)
# ============================================
# AUTO_START_PRODUCER : Lancement automatique du producteur Kafka depuis le notebook Silver
# - true : Le producteur est lancé automatiquement (par défaut)
# - false : Le producteur doit être lancé manuellement
AUTO_START_PRODUCER=true
